{
  "name": "mitriva-api",
  "version": "1.0.4",
  "private": true,
  "description": "Mitriva standalone production API",
  "main": "app.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "node -e \"console.log('Mitriva API build complete')\"",
