PORT=3000
NODE_ENV=production

# Dedicated Mitriva MySQL database
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
MYSQL_POOL_LIMIT=10

# Server-only signing secret; use a unique long random value.
MITRIVA_JWT_SECRET=

# Existing Google OAuth Web Client ID (ends in .apps.googleusercontent.com).
MITRIVA_GOOGLE_CLIENT_ID=
CORS_ORIGINS=

# Production SMS: select ICONAI sender in MSG91 and map the MSG91 flow to the Vi DLT-approved Mitriva content template.
# Vi DLT content template ID: 1177179501109764794 ; sender ICONAI ; entity/PE ID: 1101489780000100147.
# MSG91_TEMPLATE_ID must be the separate MSG91 SMS template/Flow ID, NOT the Vi DLT ID.
# Obtain a scoped MSG91 API auth key in the MSG91 dashboard; store it ONLY as a GoDaddy secret.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VARIABLE=num
# Local developer testing only. Always false when NODE_ENV=production.
MITRIVA_TEST_OTP_ENABLED=false

# Google Play reviewer account: use only a dedicated non-customer reviewer number.
MITRIVA_PLAY_REVIEW_ENABLED=false
MITRIVA_PLAY_REVIEW_PHONE=
MITRIVA_PLAY_REVIEW_OTP=

# Razorpay premium subscriptions (same dashboard login, approved dedicated Mitriva MID).
# NEVER use the TaazaDrop MID for dating subscriptions without provider approval.
# Stay OFF until both Razorpay and Play Console have explicitly approved the flow.
MITRIVA_RAZORPAY_ENABLED=false
MITRIVA_RAZORPAY_BUSINESS_APPROVED=false
MITRIVA_GOOGLE_PLAY_ALT_BILLING_APPROVED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MITRIVA_RAZORPAY_WEBHOOK_SECRET=
MITRIVA_RZP_MONTHLY_PLAN_ID=
MITRIVA_RZP_QUARTERLY_PLAN_ID=
MITRIVA_RZP_ANNUAL_PLAN_ID=
