PORT=3000
NODE_ENV=production

# Dedicated Mitriva MySQL database
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
MYSQL_POOL_LIMIT=10

# Server-only signing secret; use a unique long random value.
MITRIVA_JWT_SECRET=

# Existing Google OAuth Web Client ID (ends in .apps.googleusercontent.com).
MITRIVA_GOOGLE_CLIENT_ID=
CORS_ORIGINS=

# Configure only when production phone OTP/SMS is enabled.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VARIABLE=

# Google Play reviewer account: use only a dedicated non-customer reviewer number.
MITRIVA_PLAY_REVIEW_ENABLED=false
MITRIVA_PLAY_REVIEW_PHONE=
MITRIVA_PLAY_REVIEW_OTP=
